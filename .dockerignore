# Keep the Railway image context clean.

.git
.gitignore

# Python tooling artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
venv/
.venv/

# Node artifacts — the dashboard is built on Vercel, not inside this image
node_modules/
frontend/node_modules/
frontend/dist/

# Local secrets — must never be baked into the image (Railway sets env vars at
# runtime). The example file stays because it documents the configuration.
.env
.env.*
!.env.example

# Local junk
*.log
*.tmp
Thumbs.db
Desktop.ini
.DS_Store
test-results/
