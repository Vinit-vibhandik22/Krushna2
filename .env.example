# ---- Oil Spill Detection & Vessel Attribution - configuration ----

# Copernicus Data Space Ecosystem (free account: https://dataspace.copernicus.eu)
CDSE_USER=
CDSE_PASS=

# Sentinel Hub Process API (same CDSE account)
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_RESOLUTION_M=40

# Area of interest: Indian Coastal Waters (lon_min, lat_min, lon_max, lat_max)
# Arabian Sea + Bay of Bengal: 68E-92E, 8N-24N
AOI_BBOX=68.0,8.0,92.0,24.0

# aisstream.io API key (free at https://aisstream.io/) - Indian waters AIS coverage
AISSTREAM_API_KEY=your_aisstream_key_here

# Poll intervals (seconds)
AIS_POLL_SECONDS=30
MET_REFRESH_SECONDS=3600
SAT_POLL_SECONDS=600

# Drift model
DRIFT_HOURS_BACK=18
DRIFT_HOURS_FWD=24
PARTICLES=600

# Storage
DATA_DIR=data
DB_PATH=data/app.db

# API authentication (empty = no auth)
API_KEY=

# Scene cache management
SCENE_CACHE_MAX_GB=10
SCENE_TTL_DAYS=7
